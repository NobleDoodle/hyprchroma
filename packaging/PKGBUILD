# Maintainer: NobleDoodle <nobledoodle@users.noreply.github.com>
pkgname=hyprchroma
pkgver=1.3.0
pkgrel=1
pkgdesc="Carry the active Omarchy theme palette into GTK, Qt/KDE, Dark Reader and Pear Desktop"
arch=('any')
url="https://github.com/NobleDoodle/hyprchroma"
license=('MIT')
# omarchy is where the palette comes from; without it this daemon has nothing
# to follow and says so rather than starting. It is not in the official repos,
# so it cannot be a hard depends= for a package built against them -- named
# here so the requirement is not silent.
depends=('bash' 'python' 'jq' 'coreutils')
optdepends=(
  'omarchy: first-class palette source with automatic theme-set hooks; without it, supply ~/.config/hyprchroma/palette.toml'
  'hyprland: required in practice - the daemon watches its event stream'
  'adw-gtk-theme: GTK 3 applications follow the theme'
  'python-plyvel: Dark Reader theming in Chromium-family browsers'
  'libnotify: desktop notifications when a sync defers'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f816a271d06d6568ec91d371e005058374f7b6940ef2c36f42122c2f50410dcc')

check() {
  cd "$pkgname-$pkgver"
  make check
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
